REDIS_URL=redis://localhost:6379/0
WORKER_COUNT=2
GLOBAL_MAX_PAGES=50
MAX_PAGES_PER_RUN=500
PEL_TIMEOUT_MS=300000
MAX_RETRIES=3
MAX_DEPTH=2
HOSTNAME=

# ---------------------------------------------------------------------------
# Phase 3: Rate Limiting & Evasion
# ---------------------------------------------------------------------------
# Maximum concurrent workers scraping the same domain at the same time.
# Set to 0 to disable domain throttling.
MAX_CONCURRENT_PER_DOMAIN=2

# Comma-separated proxy URLs for the primary HTTP session (FetcherSession).
# Leave empty to fall back to the local machine IP (Graceful Degradation).
# Example: http://user1:pass1@dc1.example.com:8080,http://user2:pass2@dc2.example.com:8080
DATACENTER_PROXIES=

# Comma-separated proxy URLs for the stealth Playwright session.
# Parsed into Playwright dict format: {server, username, password}.
# Leave empty to fall back to the local machine IP (Graceful Degradation).
# Example: http://res-user1:res-pass1@res1.example.com:9090,http://res-user2:res-pass2@res2.example.com:9090
RESIDENTIAL_PROXIES=
