# ===========================================================================
# Nexus Audit Crawler & Query API -- Environment Variables
# ===========================================================================

# Redis / Upstash Connection
REDIS_URL=redis://localhost:6379/0

# Database (Supabase PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres

# Appwrite Storage (Blob Markdown & Screenshots)
APP_WRITE_PROJECT_ID=
APP_WRITE_API_ENDPOINT=https://cloud.appwrite.io/v1
APP_WRITE_API_KEY=
APP_WRITE_BUCKET_ID=

# Crawler Execution & Concurrency
WORKER_COUNT=2
GLOBAL_MAX_PAGES=50
MAX_PAGES_PER_RUN=100
MAX_DEPTH=2
MAX_RETRIES=3
PEL_TIMEOUT_MS=300000
MAX_CONCURRENT_PER_DOMAIN=2

# API Server Port (Render sets this dynamically to $PORT)
PORT=8000

# Optional Proxies (Comma-separated)
DATACENTER_PROXIES=
RESIDENTIAL_PROXIES=

# Optional Screenshot & Rendering Config
SCREENSHOT_ENABLED=false
SCREENSHOT_FULL_PAGE=true
NETWORK_IDLE_TIMEOUT_MS=3000
